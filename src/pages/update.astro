---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { existsSync, statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Gather every firmware asset that opts into the web Update tool (has method + webPath).
const all = [
  ...await getCollection('fc'),
  ...await getCollection('gnss'),
  ...await getCollection('esc'),
  ...await getCollection('motor'),
  ...await getCollection('camera'),
];
type Row = { product: string; version: string; kind: string; method: string; path: string; file: string; size: string; family: string; mcu: string; signed: boolean };
// File size in KB, read from the public/ asset at build time.
function kbOf(webPath: string): string {
  try {
    const p = fileURLToPath(new URL('../../public' + webPath, import.meta.url));
    return Math.round(statSync(p).size / 1024).toLocaleString('en-US') + ' KB';
  } catch { return ''; }
}
// Does this artifact ship an Ed25519 release-signature manifest next to it?
// Decided at BUILD time from the file on disk, then baked into the row as
// data-signed. Doing it here (not by probing at runtime) means a missing or
// removed manifest is a hard failure in the browser instead of silently
// downgrading to "unverified" -- the page already knows it must verify.
function signedOf(webPath: string): boolean {
  try {
    return existsSync(fileURLToPath(new URL('../../public' + webPath + '.aff4t10.json', import.meta.url)));
  } catch { return false; }
}
const rows: Row[] = [];
for (const e of all) {
  // The DFU chip guard needs each board's MCU family (F4/F7/H7), read from its specs.
  const mcu = e.data.specs?.find((s) => s.key === 'MCU')?.value || '';
  const family = /H7/i.test(mcu) ? 'H7' : /F7/i.test(mcu) ? 'F7' : /F4/i.test(mcu) ? 'F4' : '';
  for (const fw of e.data.firmware ?? []) {
    if (fw.method && fw.webPath) {
      rows.push({ product: e.data.name, version: fw.version, kind: fw.kind, method: fw.method, path: base + fw.webPath, file: fw.webPath.split('/').pop() || '', size: kbOf(fw.webPath), family, mcu, signed: signedOf(fw.webPath) });
    }
  }
}
// Sort alphabetically, then numerically (natural order): AF-F4 < AF-F7 < AF-H7 < AF-H7E.
rows.sort((a, b) =>
  a.product.localeCompare(b.product, 'en', { numeric: true, sensitivity: 'base' })
  || a.version.localeCompare(b.version, 'en', { numeric: true })
);
// Families whose full web flow (serial OTA + software DFU + DFU flash) is verified on real
// hardware. F4 (long-standing), H7 (AF-H7E, 2026-07: buttonless software DFU via param4=99
// magic + bootloader self-heal), and F7 (AF-F7 Mini, verified 2026-07-09: param4=99 → 0483:df11,
// app+bootloader flashed to board_id 6201 over serial, then a full DFU erase+write+leave→boot).
// Windows needs the one-time WinUSB (Zadig) step on the df11 device, same as F4/H7.
const WEB_UPDATE_FAMILIES = ['F4', 'F7', 'H7'];
const fwRows = rows.filter((r) => r.method !== 'dfu' && WEB_UPDATE_FAMILIES.includes(r.family));
const dfuRows = rows.filter((r) => r.method === 'dfu' && WEB_UPDATE_FAMILIES.includes(r.family));
---
<Layout title="Firmware Update — novaX Catalog" activeCategory="update">
  <section class="detail-body">
    <div class="container update-tool">
      <div class="crumb">Update</div>
      <h1>Firmware Update</h1>

      <div class="seg" role="tablist">
        <button data-mode="fw" class="on">⚡ Firmware Update <span class="tag">· normal</span></button>
        <button data-mode="dfu">🛠 DFU Recovery <span class="tag">· blank / bricked</span></button>
      </div>

      <p class="mode-note" data-note="fw">Normal update over USB — device stays running, no jumper. Switch to <b>DFU Recovery</b> only if the board is blank or won't boot.</p>
      <p class="mode-note" data-note="dfu" hidden><b>Pick a recovery image (<code>_with_bl.hex</code>) below</b>, then click <b>🛠 Enter DFU</b> to put a running board into USB DFU — buttonless (verified on AF-F4, AF-F7, and AF-H7E). Windows needs a one-time WinUSB driver (Zadig).</p>

      <div class="banner" data-banner="fw">
        <div class="step"><b>① Pick firmware</b>Plug in USB-C (no jumper, no BOOT0) and select the <code>.apj</code> below.</div>
        <div class="step"><b>② Connect</b>Click 🔌 Connect and pick your board's port (<code>ArduPilot</code>) in the popup.</div>
        <div class="step"><b>③ Update</b>Click ⚡ Update firmware — it reboots to the bootloader and flashes.</div>
        <div class="step good"><b>Driver</b>None — standard USB serial (CDC). Chrome/Edge desktop.</div>
      </div>
      <div class="banner" data-banner="dfu" hidden>
        <div class="step"><b>① Pick firmware</b>Select the matching <code>_with_bl.hex</code> below — it enables the buttons.</div>
        <div class="step"><b>② Enter DFU</b>Board runs (shows a COM port)? Click 🛠 Enter DFU. <b>Already in DFU?</b> Skip this → go to ③.</div>
        <div class="step"><b>③ Flash</b>Click ⚡ Flash (DFU) — the browser asks you to pick the STM32 DFU device (0483:DF11) once, then erase → write → verify. On <b>AF-H7E</b> the app then boots automatically. Chrome/Edge desktop.</div>
        <div class="step warn"><b>Windows</b>WebUSB needs a one-time WinUSB driver (Zadig) on the DFU device.</div>
      </div>

      <div class="card">
        <div class="head">Select firmware <span id="listmode">(application image)</span></div>
        <table class="cfg-table fwsel">
          <thead><tr><th style="width:34px"></th><th>Product</th><th>Version</th><th>File</th></tr></thead>
          <tbody data-list="fw">
            {fwRows.length === 0 && <tr><td colspan="4" class="empty">No web-flashable app firmware yet.</td></tr>}
            {fwRows.map((r, i) => (
              <tr class="fwrow" data-method={r.method} data-path={r.path} data-name={`${r.product} ${r.version}`} data-family={r.family} data-mcu={r.mcu} data-signed={r.signed ? "1" : "0"}>
                <td><span class="rad" data-radio></span></td>
                <td class="pname">{r.product}</td><td>{r.version}</td>
                <td><code>{r.file}</code> <span class="mtag">{r.method}</span>{r.size && <span class="fsize">{r.size}</span>}</td>
              </tr>
            ))}
          </tbody>
          <tbody data-list="dfu" hidden>
            {dfuRows.length === 0 && <tr><td colspan="4" class="empty">No web-flashable recovery image yet.</td></tr>}
            {dfuRows.map((r) => (
              <tr class="fwrow" data-method={r.method} data-path={r.path} data-name={`${r.product} ${r.version}`} data-family={r.family} data-mcu={r.mcu} data-signed={r.signed ? "1" : "0"}>
                <td><span class="rad" data-radio></span></td>
                <td class="pname">{r.product}</td><td>{r.version}</td>
                <td><code>{r.file}</code> <span class="mtag">{r.method}</span>{r.size && <span class="fsize">{r.size}</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <label class="drop" id="drop">… or drag &amp; drop a firmware file here (<span data-droptypes>.apj / .bin</span>)
          <input type="file" id="file" hidden /></label>
      </div>

      <div class="row-connect">
        <button id="connect" class="btn btn-line">🔌 Connect</button>
        <button id="softdfu" class="btn btn-line" hidden title="실행 중인 보드를 소프트웨어로 ROM DFU에 진입시킴 (AF-F4 ≥ v0.2.2 / T10 ≥ v0.3.2 / nano v2 ≥ v1.0.1 / AF-F7 ≥ v0.2.4 / AF-H7E ≥ v0.2.2)">🛠 Enter DFU</button>
        <button id="dfuconnect" class="btn btn-line" hidden title="보드가 DFU(0483:DF11)에 있을 때 WebUSB 장치 선택 팝업을 새 클릭으로 열어 연결 (브라우저 제스처 요구 우회)">🔌 Connect DFU device</button>
        <span id="status" class="chip">Not connected</span>
      </div>

      <div class="actions">
        <button id="flash" class="btn btn-primary" disabled>⚡ Update firmware</button>
        <button id="reloadpage" class="btn btn-line" type="button" title="Clear caches + refresh the page (F5) — releases the USB/COM port and re-detects the device">🔄 Reload</button>
        <span class="hint" id="flowhint">reboot to bootloader → erase → program → verify → boot</span>
      </div>

      <div class="log" id="log"><div class="bar"><i id="bar"></i></div><div id="loglines"><span class="pend">Connect a device and pick firmware to begin.</span></div></div>
    </div>
  </section>
</Layout>

<style>
  .update-tool { max-width: 960px; }
  .update-tool [hidden] { display: none !important; } /* author .banner{display:flex} would otherwise override UA [hidden] */
  .update-tool .crumb { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-4); }
  .update-tool h1 { font-size: 30px; margin: 8px 0 18px; }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; margin-bottom: 8px; }
  .seg button { border: 0; background: #fff; padding: 12px 20px; font-size: 14px; font-weight: 600; color: var(--ink-3); cursor: pointer; }
  .seg button.on { background: var(--blue, #1a73e8); color: #fff; }
  .seg .tag { font-size: 11px; font-weight: 500; opacity: .8; }
  .mode-note { font-size: 12.5px; color: var(--ink-4); margin: 4px 0 22px; }
  .banner { display: flex; gap: 14px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; margin-bottom: 22px; }
  .banner .step { flex: 1; font-size: 12.5px; color: var(--ink-3); }
  .banner .step b { display: block; color: var(--ink); font-size: 13px; margin-bottom: 3px; }
  .banner .good { color: #127a2e; } .banner .warn { color: #b26a00; }
  .row-connect { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
  .btn { border: 0; border-radius: 8px; padding: 11px 18px; font-size: 13.5px; font-weight: 600; cursor: pointer; }
  .btn-line { background: #fff; border: 1px solid #cfcfcf; color: var(--ink); }
  .btn-primary { background: var(--blue, #1a73e8); color: #fff; }
  .btn-primary[disabled] { background: #c7d6f3; cursor: not-allowed; }
  .btn[disabled], .btn:disabled { opacity: .42; cursor: not-allowed; }
  .btn.pulse { animation: btnpulse 1.15s ease-in-out infinite; }
  @keyframes btnpulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(26,115,232,.55); } 50% { box-shadow: 0 0 0 7px rgba(26,115,232,0); } }
  @media (prefers-reduced-motion: reduce) { .btn.pulse { animation: none; outline: 2px solid var(--blue, #1a73e8); outline-offset: 2px; } }
  .chip { font-size: 12.5px; padding: 5px 11px; border-radius: 20px; border: 1px solid var(--line); color: var(--ink-3); }
  .chip.ok { color: #127a2e; border-color: #bfe3c8; background: #f1faf3; }
  .chip.err { color: #b22; border-color: #f0c4c4; background: #fcf2f2; }
  .fwsel .fwrow { cursor: pointer; }
  .fwsel .fwrow.sel td { background: #f3f8ff; }
  .fwsel .empty { color: var(--ink-4); text-align: center; }
  .rad { width: 15px; height: 15px; border-radius: 50%; border: 2px solid #bbb; display: inline-block; vertical-align: middle; }
  .fwrow.sel .rad { border-color: var(--blue, #1a73e8); box-shadow: inset 0 0 0 3px var(--blue, #1a73e8); }
  .mtag { font-size: 10.5px; font-weight: 700; padding: 2px 7px; border-radius: 5px; background: #eef; color: #3651c9; margin-left: 6px; }
  .drop { display: block; margin: 4px 18px 16px; padding: 14px; border: 1px dashed var(--line); border-radius: 8px; color: var(--ink-4); font-size: 12.5px; text-align: center; cursor: pointer; }
  .drop.over { border-color: var(--blue, #1a73e8); color: var(--blue, #1a73e8); }
  .actions { display: flex; align-items: center; gap: 16px; margin: 16px 0; }
  .actions .hint { font-size: 12.5px; color: var(--ink-4); }
  .log { background: #0e0f12; color: #cdd3da; border-radius: 10px; padding: 14px 16px; font-family: ui-monospace, Menlo, monospace; font-size: 12.5px; line-height: 1.7; }
  .log .bar { height: 8px; border-radius: 5px; background: #2a2d33; overflow: hidden; margin-bottom: 10px; }
  .log .bar i { display: block; height: 100%; width: 0; background: var(--blue, #1a73e8); transition: width .15s; }
  .log .ok { color: #5fd08a; } .log .pend { color: #6f7888; } .log .err { color: #ef6f6f; }
  .fsize { margin-left: 8px; color: var(--ink-4, #888); font-size: 12px; white-space: nowrap; }
</style>

<script>
  import { STM32Dfu } from '../scripts/update/dfu';
  import { parseIntelHex } from '../scripts/update/intel-hex';
  import { Px4Updater } from '../scripts/update/serial-px4';
  import { parseApj, parseBin } from '../scripts/update/apj';

  const BUILD = '2026-07-21c * REVERTED the H7E leave-jump auto-boot (it did NOT boot from the browser and left the board stuck in DFU). H7E DFU again RESTORES BOOT_CM7_ADD0=0x08000000 so a power-cycle boots the app. DFU device picker stays consistent with serial (Flash (DFU) always shows the picker).';
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const logEl = $('#loglines'), barEl = $('#bar') as HTMLElement, statusEl = $('#status');
  const connectBtn = $('#connect') as HTMLButtonElement, flashBtn = $('#flash') as HTMLButtonElement;
  let mode: 'fw' | 'dfu' = 'fw';
  let conn: any = null;
  // Serial tab: true once 🔌 Connect has rebooted the running app into its bootloader. The board is
  // now on a NEW COM port the browser hasn't granted, so the next step is ⚡ Update — which opens the
  // picker for that port and flashes. Reset on firmware/port re-selection and tab switch.
  let serialRebooted = false;
  let selectedPath: string | null = null;
  let droppedFile: File | null = null;
  let selectedFamily: string | null = null; // F4/F7/H7 of the picked catalog firmware (DFU guard)
  let selectedName: string | null = null;
  let selectedSigned = false;   // this catalog artifact ships an Ed25519 manifest

  const log = (m: string, cls = '') => { const d = document.createElement('div'); if (cls) d.className = cls; d.textContent = m; logEl.appendChild(d); logEl.scrollTop = 1e9; };
  const progress = (done: number, total: number) => { barEl.style.width = total ? `${Math.round((done / total) * 100)}%` : '0'; };
  const setStatus = (t: string, cls = '') => { statusEl.textContent = t; statusEl.className = 'chip ' + cls; };
  // Both tabs connect-on-action: the Update/Flash button opens the device picker itself, so it
  // is enabled as soon as a firmware is picked — no separate Connect / Connect DFU step.
  const refreshFlashEnabled = () => { flashBtn.disabled = !(selectedPath || droppedFile); guide(); };

  // ---- next-step guidance: enable + pulse the ONE button to click next; disable/hide the rest
  // so a step can't be done out of order or by mistake. Runs on every state change. ----
  function guide() {
    const soft = $('#softdfu') as HTMLButtonElement;
    const dconn = $('#dfuconnect') as HTMLButtonElement;
    [soft, dconn, flashBtn, connectBtn].forEach((b) => b.classList.remove('pulse'));
    dconn.hidden = true; connectBtn.hidden = true;                       // Connect buttons merged into the action
    const picked = !!(selectedPath || droppedFile);
    if (mode === 'dfu') {
      soft.disabled = false;
      if (conn || !picked) { soft.hidden = true; }                       // connected, or pick firmware first
      else {                                                             // picked, not connected
        const swdfu = (selectedFamily === 'F4' || selectedFamily === 'F7' || selectedFamily === 'H7'); // software Enter DFU verified on F4 + F7 + H7
        soft.hidden = !swdfu;                                            // running board → Enter DFU first
        (swdfu ? soft : flashBtn).classList.add('pulse');                // running: Enter DFU; already in DFU: Flash
      }
      if (conn && picked) flashBtn.classList.add('pulse');
    } else {
      soft.hidden = true;
      if (picked) {
        // Explicit steps for the serial tab: Pick firmware → 🔌 Connect (choose the COM port in
        // the picker) → ⚡ Update. The Connect picker is the ONLY way to reach a board sitting in
        // the bootloader: its port (ArduPilot, PID 0x5741) is a DIFFERENT USB device than the app
        // (PID 0x5740) that the browser has no silent grant for, so getPorts() can't auto-open it,
        // but requestPort()'s picker lists every port for the user to select. flash() then detects
        // an already-in-bootloader port (trySync) and programs it directly with no reboot.
        connectBtn.hidden = false;
        if (conn || serialRebooted) flashBtn.classList.add('pulse'); // connected, or app already rebooted → ⚡ Update (opens the picker for the bootloader port, then flashes)
        else connectBtn.classList.add('pulse');                      // fresh → 🔌 Connect (pick the port; if it's the running app, Connect reboots it into the bootloader)
      }
    }
  }

  // Browsers cannot silently auto-pick a port on first use (security), but a device the
  // user has authorized before can be reopened with no picker. Try that for the active mode.
  async function autoDetect() {
    if (conn) return;
    if (mode === 'dfu') {
      // Consistency with the serial tab: do NOT silently reopen a granted DFU device. Let the user
      // pick it in the ⚡ Flash (DFU) click (a fresh gesture → WebUSB device picker) so the picker
      // ALWAYS shows and the user chooses which board — never a silent grab.
      try {
        if (await STM32Dfu.anyPresent()) setStatus('🔌 DFU device detected — pick firmware, then ⚡ Flash (DFU)', 'ok');
      } catch { /* ignore */ }
      return;
    }
    // Serial: do NOT silently open a COM port. Opening blindly seizes whatever port was
    // granted first (maybe not even this board) and would falsely report a verified link —
    // it also locks the COM so nothing else (CLI, this probe) can use it. Just hint.
    try {
      if (await Px4Updater.hasGrantedPort()) setStatus('🔌 USB port detected — click Connect', 'ok');
    } catch { /* ignore */ }
  }
  log('Web Updater build ' + BUILD, 'pend');
  autoDetect();

  // "Reload" button = clear caches + page refresh (F5). First purge any Cache-Storage entries
  // and unregister service workers (best-effort — a static site usually has none), then do a
  // cache-busting navigation: the fresh load bypasses the HTTP cache (picks up the latest
  // build), releases the exclusively-held COM/USB port, and re-detects the device. ?mode keeps
  // FW/DFU across the reload so it re-detects on the right transport.
  $('#reloadpage').addEventListener('click', async (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '🔄 Reloading…';
    try { if (self.caches) { const ks = await caches.keys(); await Promise.all(ks.map((k) => caches.delete(k))); } } catch { /* ignore */ }
    try {
      const sw = (navigator as any).serviceWorker;
      if (sw) { const rs = await sw.getRegistrations(); await Promise.all(rs.map((r: any) => r.unregister())); }
    } catch { /* ignore */ }
    location.replace(location.pathname + '?mode=' + mode + '&r=' + Date.now());
  });

  // ---- mode toggle ----
  document.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.seg button').forEach((x) => x.classList.remove('on'));
    b.classList.add('on');
    mode = (b.dataset.mode as 'fw' | 'dfu');
    document.querySelectorAll('[data-note]').forEach((n) => (n as HTMLElement).hidden = (n as HTMLElement).dataset.note !== mode);
    document.querySelectorAll('[data-banner]').forEach((n) => (n as HTMLElement).hidden = (n as HTMLElement).dataset.banner !== mode);
    document.querySelectorAll('[data-list]').forEach((n) => (n as HTMLElement).hidden = (n as HTMLElement).dataset.list !== mode);
    $('#listmode').textContent = mode === 'dfu' ? '(bootloader + app image)' : '(application image)';
    $('#flowhint').textContent = mode === 'dfu' ? 'erase → write → verify → leave DFU' : 'reboot to bootloader → erase → program → verify → boot';
    $('#flash').textContent = mode === 'dfu' ? '⚡ Flash (DFU)' : '⚡ Update firmware';
    ($('[data-droptypes]') as HTMLElement).textContent = mode === 'dfu' ? '.hex' : '.apj / .bin';
    ($('#softdfu') as HTMLElement).hidden = true; // Enter DFU is revealed by guide() once a DFU recovery image is picked (F4/H7)
    ($('#dfuconnect') as HTMLElement).hidden = true; // deprecated: "Connect DFU" is merged into the Flash button
    connectBtn.hidden = true; // both tabs connect-on-action (Update/Flash opens the picker); guide() keeps this hidden
    // reset connection/selection on mode switch (different transport)
    if (conn) { conn.close?.(); conn = null; }
    serialRebooted = false;
    selectedPath = null; droppedFile = null;
    document.querySelectorAll('.fwrow').forEach((r) => r.classList.remove('sel'));
    setStatus('Not connected'); refreshFlashEnabled();
    autoDetect();
  }));

  // ---- Software DFU (no BOOT0 button): from the running app (Web Serial), send the
  // ArduPilot boot-to-DFU magic; the board resets into the ST ROM DFU (0483:DF11). Then the
  // user switches to DFU Recovery (WebUSB) to flash. Requires firmware whose bootloader has
  // ENABLE_DFU_BOOT (novaX ≥ v0.2.2 / T10 ≥ v0.3.2). ----
  $('#softdfu').addEventListener('click', async () => {
    if (mode !== 'dfu') return;
    // Software boot-to-DFU is verified on F4, F7 (AF-F7 Mini, 2026-07-09) and H7 (AF-H7E):
    // param4=99 magic -> ST ROM DFU (0483:df11), then a full DFU erase+write+leave -> boot.
    if (selectedFamily !== 'F4' && selectedFamily !== 'F7' && selectedFamily !== 'H7') {
      log('Software DFU (Enter DFU) is verified on AF-F4, AF-F7, and AF-H7E — pick a matching recovery image first.', 'err');
      setStatus('Software DFU: F4 / F7 / H7 only', 'err');
      return;
    }
    try {
      // 0) If a DFU device is already present (board already in DFU — maybe several boards),
      //    show the WebUSB picker so the USER selects the intended one (never a silent grab of
      //    another board's DFU). anyPresent()/getDevices() does NOT consume the click gesture,
      //    so requestDevice() is still allowed after it. If NONE is present the board is still
      //    running → skip to the serial boot-to-DFU below (its COM picker lets the user pick
      //    the board), then reconnect to the df11 it lands in.
      let c: any = (await STM32Dfu.anyPresent()) ? await STM32Dfu.connect().catch(() => null) : null;
      if (!c) {
        // 1) Running board → put it into ROM DFU over Web Serial (best-effort; skipped if the
        //    board is already in DFU / blank, in which case the COM picker is just cancelled).
        try {
          setStatus('Select the running board (its COM port) …', 'pend');
          log('Connecting to the running app over Web Serial …', 'pend');
          const px4 = await Px4Updater.connect(115200, true);   // Enter DFU: ALWAYS show the COM-port picker so the user chooses which board goes into DFU
          log('Sending boot-to-DFU magic (param4=99) …', 'pend');
          await px4.enterRomDfu(log);                          // app drops USB & resets into ROM DFU
          log('Waiting for the board to re-appear as STM32 DFU (0483:DF11) …', 'pend');
          await new Promise((r) => setTimeout(r, 1500));
        } catch (e: any) {
          log('Serial step skipped (' + (e?.message || e) + ') — board may already be in DFU.', 'pend');
        }
        // 2) Board is now in ROM DFU (0483:DF11). Do NOT silently reconnect it — that would let the
        //    ⚡ Flash click skip the device picker (the inconsistency we're fixing). The WebUSB picker
        //    also can't run here (the awaits above consumed this click's gesture). So always route to
        //    ⚡ Flash (DFU): a fresh click opens the picker, the user selects the df11 device, and
        //    flash() verifies the chip family/capacity before erasing anything.
        log('Board is now in STM32 DFU (0483:DF11). Click ⚡ Flash (DFU) — it opens the device picker, then flashes.', 'pend');
        setStatus('In DFU — click ⚡ Flash (DFU)', 'pend');
        ($('#softdfu') as HTMLButtonElement).disabled = true;              // entered DFU — retire Enter DFU
        ($('#softdfu') as HTMLElement).classList.remove('pulse');
        flashBtn.disabled = false;
        flashBtn.classList.add('pulse');                                  // ← next: ⚡ Flash (DFU) picks + flashes
        return;
      }
      // Guard: the picked/connected DFU device must match the selected firmware's chip, so
      // picking the wrong board (e.g. an F4 in DFU while F7 firmware is selected) is rejected
      // here — not silently connected — before any flash.
      if (c && selectedFamily && typeof (c as any).flashInfo === 'function') {
        const fam = (c as any).flashInfo().family;
        if (fam !== 'unknown' && fam !== selectedFamily) {
          log(`Wrong DFU device — it is an STM32${fam}, but you picked STM32${selectedFamily} firmware (${selectedName}). Click 🛠 Enter DFU again and select the ${selectedName} board's DFU device.`, 'err');
          try { await (c as any).close?.(); } catch { /* ignore */ }
          setStatus('Wrong DFU device — pick again', 'err');
          return;
        }
      }
      conn = c; setStatus('● ' + c.chipLabel(), 'ok');
      log('DFU connected (' + c.chipLabel() + '). Pick the *_with_bl.hex and click Flash (DFU).', 'ok');
      refreshFlashEnabled();
    } catch (e: any) {
      log('Software DFU failed: ' + (e?.message || e) + ' — if the board never entered DFU, its bootloader may lack ENABLE_DFU_BOOT (novaX ≥ v0.2.2 / T10 v0.3.2); otherwise use BOOT0.', 'err');
      setStatus('Software DFU failed', 'err');
    }
  });

  // (a)+(b) — connect the DFU device in a FRESH user-gesture. STM32Dfu.connect() calls
  // navigator.usb.requestDevice() (the WebUSB device picker) as the FIRST thing in this
  // handler, so the browser allows it — unlike the #softdfu flow where the re-enumeration
  // wait consumes the gesture. Revealed by #softdfu once the board is in DFU; also works
  // directly for a BOOT0 board already sitting in 0483:DF11.
  $('#dfuconnect').addEventListener('click', async () => {
    try {
      const c: any = await STM32Dfu.connect();               // navigator.usb.requestDevice(...) → picker
      if (selectedFamily && typeof c.flashInfo === 'function') {
        const fam = c.flashInfo().family;
        if (fam !== 'unknown' && fam !== selectedFamily) {
          log(`Wrong DFU device — it is an STM32${fam}, but you picked STM32${selectedFamily} firmware (${selectedName}). Connect the ${selectedName} board's DFU device.`, 'err');
          try { await c.close?.(); } catch { /* ignore */ }
          setStatus('Wrong DFU device — pick again', 'err'); return;
        }
      }
      ($('#dfuconnect') as HTMLElement).hidden = true;
      conn = c; setStatus('● ' + c.chipLabel(), 'ok');
      log('DFU connected (' + c.chipLabel() + '). Pick the *_with_bl.hex and click Flash (DFU).', 'ok');
      refreshFlashEnabled();
    } catch (e: any) {
      const msg = String(e?.message || e);
      log('DFU connect failed: ' + msg, 'err');
      setStatus('DFU connect failed', 'err');
      // #1 cause on Windows: the STM32 DFU device is not bound to WinUSB, so Chrome cannot
      // claim it. Give the operator the exact one-time fix instead of a cryptic error.
      if (/claim|access|denied|InvalidState|SecurityError|Unable|protected|blocklist/i.test(msg))
        log('→ Windows driver: this DFU device needs WinUSB. Run Zadig ONCE — pick "STM32 BOOTLOADER" (0483:DF11) → WinUSB → Install/Replace Driver → then click 🔌 Connect DFU device again. One-time per PC/USB port.', 'pend');
      else if (/No device|NotFound|selected/i.test(msg))
        log('→ No STM32 DFU (0483:DF11) offered. Blank/new board? Hold BOOT0 + replug to enter DFU. Already in DFU but not listed? Windows needs the WinUSB driver (Zadig, as above).', 'pend');
    }
  });

  // After a Reload, restore the saved mode (carried in ?mode=…) so USB re-detects on the
  // right transport — WebSerial for FW, WebUSB for DFU.
  if (new URLSearchParams(location.search).get('mode') === 'dfu') {
    (document.querySelector('.seg button[data-mode="dfu"]') as HTMLButtonElement)?.click();
  }

  // ---- row selection ----
  document.querySelectorAll<HTMLElement>('.fwrow').forEach((row) => row.addEventListener('click', () => {
    row.parentElement!.querySelectorAll('.fwrow').forEach((r) => r.classList.remove('sel'));
    row.classList.add('sel');
    selectedPath = row.dataset.path || null; droppedFile = null;
    selectedFamily = row.dataset.family || null; selectedName = row.dataset.name || null;
    selectedSigned = row.dataset.signed === '1';
    serialRebooted = false; // re-selecting firmware restarts the Connect→Update sequence
    // If we were auto-reconnected to a DFU device of a DIFFERENT chip (e.g. an F4 sitting in DFU
    // while the user now picks F7 firmware), release it so we neither flash nor stay "connected"
    // to the wrong board. The buttons below then re-reveal to connect the intended board.
    if (mode === 'dfu' && conn && selectedFamily && typeof (conn as any).flashInfo === 'function'
        && (conn as any).flashInfo().family !== selectedFamily) {
      const wrongFam = (conn as any).flashInfo().family;
      try { (conn as any).close?.(); } catch { /* ignore */ }
      conn = null; setStatus('Not connected', '');
      log(`Released the STM32${wrongFam} DFU device — you picked STM32${selectedFamily} firmware. Use 🛠 Enter DFU (or 🔌 Connect DFU device) to connect the intended board.`, 'pend');
    }
    // Software-DFU families (F4/F7/H7). Reveal BOTH: 🛠 Enter DFU (running board → software DFU)
    // AND 🔌 Connect DFU device (board ALREADY in DFU — blank board on BOOT0, or a previous run —
    // connects directly without Enter DFU). Both hidden once we're already connected (auto-reconnect).
    const swdfuFam = (mode === 'dfu' && (selectedFamily === 'F4' || selectedFamily === 'F7' || selectedFamily === 'H7'));
    ($('#softdfu') as HTMLElement).hidden = !swdfuFam || !!conn;
    ($('#dfuconnect') as HTMLElement).hidden = !swdfuFam || !!conn;
    refreshFlashEnabled();
  }));

  // ---- drag & drop ----
  const drop = $('#drop'), fileInput = $('#file') as HTMLInputElement;
  drop.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) pickFile(fileInput.files[0]); });
  ['dragover', 'dragenter'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => { const f = (e as DragEvent).dataTransfer?.files?.[0]; if (f) pickFile(f); });
  function pickFile(f: File) {
    droppedFile = f; selectedPath = null;
    selectedFamily = null; selectedName = null; // dropped file → no catalog family to match against
    ($('#softdfu') as HTMLElement).hidden = true; // unknown family for a dropped file → no software DFU button
    document.querySelectorAll('.fwrow').forEach((r) => r.classList.remove('sel'));
    log(`File selected: ${f.name} (${f.size} bytes)`);
    refreshFlashEnabled();
  }

  // ---- connect ----
  connectBtn.addEventListener('click', async () => {
    try {
      if (mode === 'dfu') {
        conn = await STM32Dfu.connect();
        setStatus('● ' + conn.chipLabel(), 'ok');
        log('Connected. Detected chip: ' + conn.chipLabel(), 'ok');
      } else {
        // ALWAYS show the picker so the user chooses the board's port (incl. a bootloader port the
        // browser hasn't silently granted). Then: if they picked the bootloader → ready to flash;
        // if they picked the running app → reboot it into the bootloader (which comes back as a NEW
        // port) and ask them to Connect + pick that one. This is why "pick a port" enters the
        // bootloader, exactly as expected.
        const px4 = await Px4Updater.connect(115200, true);
        if (await px4.isBootloader()) {
          conn = px4; serialRebooted = false;
          setStatus('● bootloader connected', 'ok');
          log('Connected to the bootloader — click ⚡ Update firmware to flash.', 'ok');
        } else {
          log('Connected to the app — rebooting it into the bootloader …', 'ok');
          await px4.rebootAppToBootloader(log);
          conn = null; serialRebooted = true;
          setStatus('Bootloader ready — click ⚡ Update', 'ok');
          log('→ Board is now in the bootloader on a NEW COM port. Click ⚡ Update firmware (now pulsing), pick "ArduPilot (COMxx)" in the picker, and it flashes.', 'pend');
        }
      }
    } catch (e: any) {
      setStatus('connect failed', 'err'); conn = null;
      log(String(e?.message || e), 'err');
      if (mode !== 'dfu')
        // A NEW/blank board (or one already in DFU) has no COM port — the normal tab can't see it.
        log('→ No serial port. A NEW / blank board — or a board already in DFU — has no COM port. Click the 🛠 DFU Recovery tab above, pick the *_with_bl.hex, then 🔌 Connect DFU device.', 'pend');
    }
    refreshFlashEnabled();
  });

  // ---- AF-F4 T10 release-signature gate -------------------------------------
  // The F405 bootloader is too small for ArduPilot secure boot, so authenticity
  // is enforced on the DISTRIBUTION path instead: every signed artifact ships an
  // Ed25519 manifest (<file>.aff4t10.json) and we verify it HERE, before a single
  // byte reaches the board. Same checks and same fail-closed rule as the CLI
  // updater (tools/serial_update.py -> af_f4_t10_fwsig.verify_file).
  const AFF4T10_PUBKEY_SPKI = 'MCowBQYDK2VwAyEArgGcHEkt8CG4VENHSnf18A+UgOT+QG7IQ6Qm55RXJL4=';

  function b64ToBytes(b64: string): Uint8Array {
    const bin = atob(b64); const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }

  async function verifyRelease(buf: ArrayBuffer, path: string, name: string) {
    const manUrl = path + '.aff4t10.json';
    const r = await fetch(manUrl);
    if (!r.ok) throw new Error(`REFUSING TO FLASH: ${name} is published as signed but its signature manifest is missing (${manUrl} -> ${r.status}).`);
    const man = await r.json();
    const data = new Uint8Array(buf);

    if (man.size !== data.length)
      throw new Error(`REFUSING TO FLASH: ${name} size ${data.length} != manifest ${man.size} (truncated or replaced).`);

    const digest = [...new Uint8Array(await crypto.subtle.digest('SHA-256', data))]
      .map((b) => b.toString(16).padStart(2, '0')).join('');
    if (digest !== man.sha256)
      throw new Error(`REFUSING TO FLASH: ${name} SHA-256 mismatch — the image was modified.`);

    let key: CryptoKey;
    try {
      key = await crypto.subtle.importKey('spki', b64ToBytes(AFF4T10_PUBKEY_SPKI), { name: 'Ed25519' }, false, ['verify']);
    } catch {
      throw new Error('REFUSING TO FLASH: this browser cannot verify Ed25519 signatures (needs a current Chrome/Edge). Use the CLI updater instead.');
    }
    const ok = await crypto.subtle.verify('Ed25519', key, b64ToBytes(man.signature), data);
    if (!ok)
      throw new Error(`REFUSING TO FLASH: ${name} is NOT signed with the novaX release key — tampered or from an untrusted source.`);

    log(`✔ signature OK — ${name} signed by ${man.key_id} (board_id ${man.board_id}, v${man.version})`, 'ok');
  }

  // ---- load firmware bytes (same-origin path or dropped file) ----
  async function loadBytes(): Promise<{ text?: string; buf?: ArrayBuffer; name: string }> {
    if (droppedFile) {
      const name = droppedFile.name;
      // A file the operator supplied themselves is outside the signed release
      // channel; we cannot authenticate it, so say so rather than implying it passed.
      log(`⚠ ${name} is a local file — release signature NOT checked. The board's own board_id + CRC still apply.`, 'pend');
      if (name.endsWith('.hex') || name.endsWith('.apj')) return { text: await droppedFile.text(), name };
      return { buf: await droppedFile.arrayBuffer(), name };
    }
    const res = await fetch(selectedPath!);
    if (!res.ok) throw new Error(`fetch ${selectedPath} → ${res.status}`);
    const name = selectedPath!.split('/').pop() || '';
    // Read the RAW bytes once: the signature is over the file as published, so
    // text and signature input must come from the same buffer (no re-encoding).
    const buf = await res.arrayBuffer();
    if (selectedSigned) await verifyRelease(buf, selectedPath!, name);
    if (name.endsWith('.hex') || name.endsWith('.apj'))
      return { text: new TextDecoder().decode(buf), name };
    return { buf, name };
  }

  // ---- flash ----
  flashBtn.addEventListener('click', async () => {
    // Serial tab: 🔌 Connect must run first — it opens the picker AND reboots the app into the
    // bootloader (or recognises a bootloader port). Don't silently connect here, or we'd grab the
    // app port and bypass that. (DFU tab keeps connect-on-action below.)
    if (mode !== 'dfu' && !conn && !serialRebooted) {
      log('→ Click 🔌 Connect first (the pulsing button) and pick your board\'s port.', 'pend');
      return;
    }
    flashBtn.disabled = true;
    try {
      // Connect-on-action: this click is a fresh user gesture, so open the device picker HERE
      // (before loadBytes()'s await consumes it) if not connected — removes the separate Connect /
      // Connect DFU step for both tabs. Normal → Web Serial; DFU → WebUSB.
      if (!conn) {
        try {
          if (mode === 'dfu') {
            conn = await STM32Dfu.connect();
            setStatus('● ' + (conn as any).chipLabel(), 'ok');
            log('DFU connected (' + (conn as any).chipLabel() + ').', 'ok');
          } else {
            // Reached only after Connect rebooted the app (serialRebooted): open the picker for the
            // NEW bootloader port, then flash() detects it (trySync) and programs directly.
            conn = await Px4Updater.connect(115200, true);
            serialRebooted = false;
            setStatus('● bootloader connected', 'ok');
            log('Connected to the bootloader.', 'ok');
          }
        } catch (e: any) {
          const msg = String(e?.message || e);
          setStatus('connect failed', 'err'); conn = null;
          log((mode === 'dfu' ? 'DFU connect' : 'Connect') + ' failed: ' + msg, 'err');
          if (mode === 'dfu' && /claim|access|denied|InvalidState|SecurityError|Unable|protected|blocklist/i.test(msg))
            log('→ Windows: this DFU device needs WinUSB. Run Zadig ONCE — "STM32 BOOTLOADER" (0483:DF11) → WinUSB → Install/Replace Driver → then click Flash again.', 'pend');
          else if (mode === 'dfu' && /No device|NotFound|selected/i.test(msg))
            log('→ No STM32 DFU (0483:DF11) offered. Running board? Click 🛠 Enter DFU first.', 'pend');
          else if (mode !== 'dfu')
            log('→ No serial port. A blank / in-DFU board has no COM port — use the 🛠 DFU Recovery tab.', 'pend');
          flashBtn.disabled = false;
          return;
        }
      }
      const src = await loadBytes();
      log(`Loaded ${src.name}`, 'ok');
      if (mode === 'dfu') {
        const text = src.text ?? new TextDecoder().decode(new Uint8Array(src.buf!));
        const hex = await parseIntelHex(text);
        log(`HEX 0x${hex.minAddress.toString(16)}–0x${hex.maxAddress.toString(16)}, ${hex.totalBytes} bytes`);
        // ---- chip guard: stop a wrong-chip flash before erasing anything ----
        const info = (conn as InstanceType<typeof STM32Dfu>).flashInfo();
        log(`Connected chip: ${(conn as InstanceType<typeof STM32Dfu>).chipLabel()}`);
        // A) capacity: the image must fit the device's flash (blocks bigger-chip firmware).
        if (hex.maxAddress > info.base + info.totalSize) {
          throw new Error(`Chip mismatch — flash aborted. This firmware writes up to 0x${hex.maxAddress.toString(16)}, but the connected chip's flash is only ${(info.totalSize / 1024) | 0} KB (up to 0x${(info.base + info.totalSize).toString(16)}). It is firmware for a larger chip.`);
        }
        // B) family: a catalog firmware knows its target family — block cross-family flashes.
        if (selectedFamily && info.family !== 'unknown' && selectedFamily !== info.family) {
          throw new Error(`Chip mismatch — flash aborted. The selected firmware is for STM32${selectedFamily}-class (${selectedName}), but the connected board is STM32${info.family}-class. Wrong board.`);
        }
        if (selectedFamily && info.family === 'unknown') {
          log('⚠ Could not auto-detect chip family — capacity check only. Verify the board yourself.', 'pend');
        }
        if (droppedFile) {
          log('Dropped file — catalog chip match skipped (capacity check only). Verify this is the right board.', 'pend');
        }
        await (conn as InstanceType<typeof STM32Dfu>).flash(hex, log, progress);
      } else {
        const img = src.name.endsWith('.apj') ? await parseApj(src.text!) : parseBin(src.buf ?? new TextEncoder().encode(src.text!).buffer);
        log(`App image ${img.bytes.length} bytes${img.boardId ? ` (board ID ${img.boardId})` : ''}`);
        if (!img.boardId && selectedName) log('⚠ This .bin has no board ID — only the capacity check applies. Verify the board yourself.', 'pend');
        await (conn as InstanceType<typeof Px4Updater>).flash(img.bytes, log, progress, img.boardId);
      }
      progress(1, 1);
      if (mode === 'dfu' && (conn as InstanceType<typeof STM32Dfu>).needsPowerCycle) {
        log('✓ Done. Unplug the USB cable and plug it back in — the app boots on the next power cycle.', 'ok');
      } else {
        log('✓ Done. Device rebooting.', 'ok');
      }
    } catch (e: any) {
      log('✗ ' + String(e?.message || e), 'err');
      if (e?.blGrantNeeded) {
        // The board is sitting in the bootloader on a COM port this browser has no grant for
        // (bootloader PID 0x5741 ≠ app PID 0x5740). Drop the dead app-port connection so the
        // next ⚡ click opens the port picker; flash() then continues via its
        // "Already in bootloader mode" path. One-time per browser — the grant persists.
        try { (conn as any)?.close?.(); } catch { /* ignore */ }
        conn = null; setStatus('Not connected', '');
        log('→ The board is now in bootloader mode on a new COM port. Click 🔌 Connect (now pulsing), pick "ArduPilot (COMxx)" in the picker, then ⚡ Update — flashing continues from the bootloader.', 'pend');
      }
    }
    flashBtn.disabled = false;
  });
</script>
