---
import Layout from '../layouts/Layout.astro';
import FirmwareTable from '../components/FirmwareTable.astro';
import Gallery from '../components/Gallery.astro';
import { getCollection } from 'astro:content';

// Desktop programs, one JSON per program under src/content/tools (a new program needs only a new file).
// Side tabs (the Update page rail) pick one program; its panel shows screenshots and every release,
// newest first, in the same table as a product's Firmware tab. The URL hash (#<id>) keeps the pick.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const mb = (bytes: number) => `${(bytes / 1048576).toFixed(1)} MB`;
const rowsOf = (t: (typeof tools)[number]) => t.data.releases.flatMap((r) => r.files.map((f) => ({
  kind: f.kind, version: r.version, date: r.date, size: mb(f.bytes), file: f.file, sha256: f.sha256, notes: f.notes,
})));
---
<Layout title="Tools — novaX Catalog" activeCategory="tool">
  <section class="detail-body">
    <div class="container page-head tool-page">
      <div class="crumb">Tool</div>
      <h1>Desktop Tools</h1>
      <div class="prose"><p>PC programs for novaX products. Pick a program in the side tabs. Check the SHA-256 of a download against the one listed here before you run it.</p></div>

      <div class="picker">
        <nav class="catnav toolnav" aria-label="Programs">
          {tools.map((t, i) => (
            <button type="button" class={i === 0 ? 'on' : ''} data-tool={t.id}>
              <img src={`${base}${t.data.icon}`} alt="" width="40" height="40" />
              <span class="tn"><b>{t.data.name}</b><small>{t.data.comingSoon && !t.data.releases.length ? 'Coming soon' : t.data.releases[0]?.version}</small></span>
            </button>
          ))}
        </nav>

        <div class="pickmain">
          {tools.map((t, i) => {
            const latest = t.data.releases[0];
            return (
              <div class="toolpanel" id={t.id} data-panel={t.id} hidden={i !== 0}>
                <div class="toolhead">
                  <img src={`${base}${t.data.icon}`} alt={t.data.name} width="72" height="72" />
                  <div>
                    <h2>{t.data.name}{latest && <span class="ver">{latest.version}</span>}</h2>
                    <div class="for">For {t.data.usedFor}</div>
                  </div>
                </div>
                <div class="prose">
                  <p>{t.data.summary}</p>
                  {latest && <p><strong>What's new in {latest.version}:</strong> {latest.changes}<br /><a href={latest.notes} target="_blank" rel="noopener">Release notes</a></p>}
                </div>
                {t.data.shots.length > 0 && <Gallery gallery={t.data.shots} name={t.data.name} />}
                {latest ? <FirmwareTable items={rowsOf(t)} productName={t.data.name} />
                  : <div class="panel-empty">{t.data.comingSoon ? 'Coming soon' : 'No download yet'}</div>}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tool-page { max-width: 1172px; } /* same width as the Update page: content + the 196 px rail */
  .tool-page [hidden] { display: none !important; }
  .toolnav button { justify-content: flex-start; align-items: center; gap: 12px; padding: 12px 13px; }
  .toolnav img { width: 40px; height: 40px; object-fit: contain; border-radius: 9px; background: var(--paper); flex: none; }
  .toolnav .tn { display: flex; flex-direction: column; gap: 2px; color: inherit; }
  .toolnav .tn small { font-size: 11.5px; font-weight: 600; color: var(--ink-4); }
  .toolnav button.on .tn small { color: #dbe8ff; }
  .toolhead { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; }
  .toolhead img { width: 72px; height: 72px; object-fit: contain; border-radius: 14px; background: var(--paper); }
  .toolhead h2 { font-size: 22px; }
  .toolhead .ver { margin-left: 10px; font-size: 13px; font-weight: 600; color: var(--ink-4); }
  .toolhead .for { font-size: 13.5px; color: var(--ink-3); margin-top: 4px; }
  .tool-page .pickmain { min-width: 0; } /* a grid item would otherwise widen to the download table and push the page past a phone screen */
  .toolpanel :global(.gallery) { margin: 6px 0 22px; }
  /* screenshots are 16:9 app windows: fill the cell instead of the 4:3 product-photo frame */
  .toolpanel :global(.gallery-grid) { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .toolpanel :global(.gallery-grid .cell) { aspect-ratio: 16 / 9; padding: 0; overflow: hidden; }
  .toolpanel :global(.gallery-grid img) { object-fit: cover; mix-blend-mode: normal; }
</style>

<script>
  // One program at a time: a side tab shows its panel; #<id> in the URL opens that program directly.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.toolnav button')];
  const panels = [...document.querySelectorAll<HTMLElement>('.toolpanel')];
  function show(id: string) {
    if (!panels.some((p) => p.dataset.panel === id)) return;
    buttons.forEach((b) => b.classList.toggle('on', b.dataset.tool === id));
    panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
  }
  buttons.forEach((b) => b.addEventListener('click', () => {
    show(b.dataset.tool!);
    history.replaceState(null, '', '#' + b.dataset.tool);
  }));
  show(decodeURIComponent(location.hash.slice(1)) || buttons[0]?.dataset.tool || '');
</script>
