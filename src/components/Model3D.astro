---
// 3D tab body shared by product pages: rotatable glTF model (e.g. the assembled PCBA).
// three.js and the model are fetched only when the tab is first shown, so the page itself stays light.
interface Props { src: string; name: string }
const { src, name } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="model3d" data-src={`${base}${src}`}>
  <canvas aria-label={`${name} 3D model`}></canvas>
  <div class="m3-status">Loading 3D model…</div>
</div>
<div class="m3-hint">Drag to rotate · scroll or pinch to zoom · right-drag to pan · double-click to reset the view</div>

<style>
  .model3d {
    position: relative; width: 100%; aspect-ratio: 4 / 3; max-height: 640px;
    background: var(--paper); border-radius: var(--radius); overflow: hidden;
  }
  .model3d canvas { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
  .model3d canvas:active { cursor: grabbing; }
  .m3-status {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-4);
    pointer-events: none;
  }
  .m3-status[hidden] { display: none; }
  .m3-hint { margin-top: 10px; font-size: 12px; color: var(--ink-4); }
</style>

<script>
  // Start when the viewer first becomes visible (tab opened or page opened on #model3d).
  document.querySelectorAll<HTMLElement>('.model3d').forEach((root) => {
    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const { mountModel } = await import('../lib/model3d-view.js');
      mountModel(root);
    });
    io.observe(root);
  });
</script>
