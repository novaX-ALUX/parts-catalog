# Default: normalize text files to LF in the repo and working tree
# (prevents CRLF noise when files are touched from Windows).
* text=auto eol=lf

# Firmware images must be stored byte-exact (no EOL/encoding conversion).
public/firmware/** binary

# Manual PDFs and their page previews must be stored byte-exact too (Illustrator PDFs can look like text).
public/manuals/** binary

# 3D models (glTF binary) for the product 3D tab.
public/models/** binary
